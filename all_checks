#!/bin/sh
# all_checks - run format/lint checks and tests for govee-python
set -eu
ROOT=$(dirname "$0")
VENV_PY="$ROOT/govee-python/.venv/bin/python"
BLACK="$ROOT/govee-python/.venv/bin/black"
ISORT="$ROOT/govee-python/.venv/bin/isort"
RUFF="$ROOT/govee-python/.venv/bin/ruff"

if [ -x "$BLACK" ] && [ -x "$ISORT" ] && [ -x "$RUFF" ]; then
  echo "running black --check..."
  XDG_CACHE_HOME="$ROOT/.uv_cache" "$BLACK" --check govee-python
  echo "running isort --check-only..."
  XDG_CACHE_HOME="$ROOT/.uv_cache" "$ISORT" --check-only govee-python
  echo "running ruff check..."
  XDG_CACHE_HOME="$ROOT/.uv_cache" "$RUFF" check govee-python/src govee-python/tests
else
  echo "format/lint tools not available in govee-python/.venv; skipping format_check"
fi

# Run lightweight test runner
if [ -x "$VENV_PY" ]; then
  "$VENV_PY" govee-python/run_tests.py
else
  echo "python interpreter not found in venv; attempting system python"
  python3 govee-python/run_tests.py
fi
